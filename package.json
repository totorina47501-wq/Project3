{
  "name": "mentioncheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:whoami": "wrangler whoami",
    "test:video:offline": "node --test --experimental-test-isolation=none workers/video/tests/*.test.mjs",
    "test:carousel:offline": "node --test --experimental-test-isolation=none workers/carousel/tests/carousel.test.mjs",
    "test:media-jobs:offline": "node --test --experimental-test-isolation=none workers/media-jobs/tests/*.test.mjs",
    "test:fixtures": "node --test --experimental-test-isolation=none scripts/e2e-fixture.test.mjs tests/e2e/fixtures/studio-http.node.mjs",
    "test:sql-harness": "node --test --experimental-test-isolation=none scripts/test-sql-offline.test.mjs",
    "test:sql:offline": "node scripts/test-sql-offline.mjs",
    "work:check": "node scripts/work-inventory.mjs check",
    "work:find": "node scripts/work-inventory.mjs find",
    "docs:links": "node scripts/check-md-links.mjs",
    "docs:links:report": "node scripts/check-md-links.mjs --report",
    "docs:links:test": "node --test scripts/check-md-links.test.mjs",
    "work:test": "node --test scripts/work-inventory.test.mjs",
    "test:cloudflare:bundle": "opennextjs-cloudflare build --skipNextBuild",
    "training:prepare": "node scripts/training/export.mjs",
    "test:training:offline": "node --test --experimental-test-isolation=none scripts/training/*.test.mjs",
    "test:privacy:offline": "node --test --experimental-test-isolation=none scripts/privacy/*.test.mjs",
    "training:revoke": "node scripts/training/revoke.mjs",
    "mia:approve": "node scripts/mia/run-approved-manifest.mjs",
    "mia:review": "node scripts/mia/run-official-review.mjs",
    "mia:discover": "node scripts/mia/run-official-discovery.mjs",
    "media:runner": "node workers/media-jobs/src/remote-run.mjs"
  },
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@fontsource/space-grotesk": "5.2.8",
    "@hookform/resolvers": "7.0.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.66.0",
    "next": "15.5.28",
    "next-themes": "0.4.6",
    "openai": "7.17.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.1.4",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "resend": "6.37.0",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "stripe": "23.1.0",
    "tailwind-merge": "2.6.1",
    "zod": "4.6.7",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@opennextjs/cloudflare": "1.20.15",
    "wrangler": "4.156.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
