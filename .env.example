# Chemin : .env.example
# Variables publiques à définir au build Next.js ET côté Worker Cloudflare.
NEXT_PUBLIC_APP_URL=https://mentioncheck.toto-rina47501.workers.dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrets exclusivement serveur (Workers > Variables and Secrets).
# Toute clé OpenAI diffusée dans un chat doit être révoquée et remplacée.
SUPABASE_SERVICE_KEY=
OPENAI_API_KEY=

# Préparation à la commercialisation.
# Stripe est désactivé par défaut et refuse les clés live.
BILLING_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
RESEND_API_KEY=
EMAIL_FROM=


# Rétention : inactif tant que le cron et le contrôle des archives ne sont pas validés.
MEDIA_RETENTION_ENABLED=false
MEDIA_RETENTION_TOKEN=
# Pour le Worker cron séparé, jamais à publier dans un frontend.
MEDIA_RETENTION_URL=https://mentioncheck.toto-rina47501.workers.dev/api/internal/media-retention


# OpenAI — protection contre les appels payants involontaires.
# La clé serveur préexistante peut être réutilisée : ne jamais la commiter ou l'afficher.
# OPENAI_PAUSED=true interrompt tous les appels OpenAI côté serveur, y compris Mia.
# Par défaut, les fonctions texte/vision déjà existantes restent compatibles.
OPENAI_PAUSED=false
OPENAI_TEXT_ENABLED=true
OPENAI_VISION_ENABLED=true
# Les deux nouvelles capacités restent désactivées, y compris si une clé existe.
OPENAI_AUDIO_ENABLED=false
OPENAI_EMBEDDINGS_ENABLED=false

# File de préparation : garder false avant migration et validation d’un exécuteur isolé.
# SCHEMA_READY doit rester true après migration si des jobs existent, même si ENABLED repasse false.
MEDIA_JOBS_SCHEMA_READY=false
MEDIA_PROCESSING_ENABLED=false

# Cloudflare Containers : activés explicitement par wrangler.jsonc en production.
# En local, aucune instance n'est lancée ; le conteneur utilise les secrets du Worker.
MEDIA_CLOUDFLARE_RUNNER_ENABLED=false
# Coupe-circuit runtime dans le tableau de bord ; ne figure pas dans vars Wrangler.
MEDIA_RUNNER_PAUSED=false
