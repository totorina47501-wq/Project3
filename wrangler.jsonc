{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mentioncheck",
  "main": "workers/cloudflare-entry.mjs",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "API_SOLO_LIMITER",
      "namespace_id": "11001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "API_PAID_LIMITER",
      "namespace_id": "11002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "containers": [
    {
      "class_name": "MediaRunner",
      "scheduling_policy": "default",
      "image": "./workers/media-jobs/Dockerfile",
      "image_build_context": ".",
      "max_instances": 1,
      "instance_type": "basic",
      "constraints": {
        "jurisdiction": "eu"
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDIA_RUNNER",
        "class_name": "MediaRunner"
      }
    ]
  },
  "exports": {
    "MediaRunner": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "MEDIA_JOBS_SCHEMA_READY": "true",
    "MEDIA_PROCESSING_ENABLED": "true",
    "MEDIA_CLOUDFLARE_RUNNER_ENABLED": "true",
    "MEDIA_AI_ENABLED": "true",
    "MEDIA_AI_SCHEMA_READY": "true",
    "OPENAI_AUDIO_ENABLED": "true"
  },
  "dev": {
    "enable_containers": false
  }
}
